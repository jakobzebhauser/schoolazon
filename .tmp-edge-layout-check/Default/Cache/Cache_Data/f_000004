}
.help-mono{
  font-family: var(--mono);
  font-weight: 900;
}
.help-icon{
  width: 18px;
  height: 18px;
  display:inline-block;
  background: linear-gradient(180deg, rgba(0,122,255,.95), rgba(175,82,222,.80));
  -webkit-mask: var(--help-icon) center / contain no-repeat;
